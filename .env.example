# No environment settings are needed. NDL remains the initially selected engine;
# Honkoku v19 is available using the bundled, pinned manifest.
# Set false only to deliberately disable Honkoku.
# VITE_ENABLE_HONKOKU=false
# Optional override. The bundled manifest is used when this is unset or blank.
# VITE_HONKOKU_MODEL_MANIFEST_URL=https://your-model-host/manifest.json
